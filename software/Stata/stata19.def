Bootstrap: docker
From: ubuntu:24.04

%files
   StataNow19Linux64.tar.gz /opt
   installv2 /opt

%post
   # On CHTC HTC systems only, otherwise, comment or delete the chmod command
   chmod 777 /tmp

   # Install system packages
   apt update && apt install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    davix-dev \
    dcap-dev \
    fonts-freefont-ttf \
    g++ \
    gcc \
    gfal2 \
    gfortran \
    git \
    iputils-tracepath \
    iputils-ping \
    libafterimage-dev \
    libavahi-compat-libdnssd-dev \
    libcfitsio-dev \
    libfftw3-dev \
    libfreetype6-dev \
    libftgl-dev \
    libgfal2-dev \
    libgif-dev \
    libgl2ps-dev \
    libglew-dev \
    libglu-dev \
    libgraphviz-dev \
    libgsl-dev \
    libjemalloc-dev \
    libjpeg-dev \
    libkrb5-dev \
    libldap2-dev \
    liblz4-dev \
    liblzma-dev \
    libmysqlclient-dev \
    libpng-dev \
    libpq-dev \
    libreadline-dev \
    libsqlite3-dev \
    libssl-dev \
    libtbb-dev \
    libtiff-dev \
    libx11-dev \
    libxext-dev \
    libxft-dev \
    libxml2-dev \
    libxpm-dev \
    libz-dev \
    libzmq3-dev \
    locales \
    lsb-release \
    lsb-release \
    make \
    openjdk-11-jdk \
    pkg-config \
    python3 \
    python3-pip \
    python3-dev \
    python3-numpy \
    python3-pandas \
    python3-scipy \
    python3-tk \
    r-base \
    r-cran-rcpp \
    r-cran-rinside \
    rsync \
    srm-ifce-dev \
    unixodbc-dev \
    unzip \
    vim \
    wget

   # Prepare install files
   cd /opt
   mkdir StataNow19Linux64
   tar -xzvf StataNow19Linux64.tar.gz -C StataNow19Linux64
   rm StataNow19Linux64.tar.gz
   mv installv2 /opt/StataNow19Linux64/

   # Prepare Stata directory
   mkdir -p /opt/stata19
   cd /opt/stata19

   # Install Stata
   /opt/StataNow19Linux64/installv2
   # Run license installer
   export PATH=/opt/stata19:$PATH
   ./stinit << EOF
y
y
<REPLACE WITH SERIAL NUMBER>
<REPLACE WITH CODE>
<REPLACE WITH AUTHORIZATION>
y
y
CHTC, University of Wisconsin-Madison
Madison, WI, USA
y
EOF

rm -r /opt/StataNow19Linux64

%environment
   export PATH=/opt/stata19:$PATH
